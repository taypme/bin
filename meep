#!/usr/bin/env bash
set -euo pipefail

base="/meep"
subdir="${1:-}"

if [ -z "$subdir" ]; then
  cd -- "$base"
  ls -al --color=auto
else
  target="${base}/${subdir}"
  if [ ! -d "$target" ]; then
    echo "Directory not found: $target" >&2
    exit 1
  fi
  cd -- "$target"
fi

exec "${SHELL:-/bin/bash}" -i
